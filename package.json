{
  "name": "hwpl-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"vite\" \"node tools/admin-server.mjs\"",
    "dev:web": "vite",
    "dev:api": "node tools/admin-server.mjs",
    "seed": "node tools/seed.mjs",
    "export": "node tools/export.mjs",
    "import": "node tools/import-from-azure.mjs",
    "build": "tsc -b && vite build && cp dist/index.html dist/404.html",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^11.8.1",
    "concurrently": "^9.1.2",
    "express": "^4.21.2",
    "typescript": "^5.6.3",
    "vite": "^8.0.11",
    "wrangler": "^4.110.0"
  }
}
